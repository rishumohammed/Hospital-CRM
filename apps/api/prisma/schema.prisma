datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  code          String         @unique @db.VarChar(50)
  name          String         @db.VarChar(100)
  type          String         @default("own") @db.VarChar(20) // own | partner
  businessHours Json?          @map("business_hours")
  timezone      String         @default("Asia/Kolkata") @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  archivedAt    DateTime?      @map("archived_at")

  userBranches  UserBranch[]
  leads         Lead[]
  patients      Patient[]
  cases         Case[]
  appointments  Appointment[]
  exports       Export[]

  @@map("branches")
}

model User {
  id             Int               @id @default(autoincrement()) @db.UnsignedInt
  name           String            @db.VarChar(100)
  email          String            @unique @db.VarChar(191)
  mobile         String            @db.VarChar(20)
  passwordHash   String            @map("password_hash") @db.VarChar(255)
  roleId         Int               @map("role_id") @db.UnsignedInt
  language       String            @default("en") @db.VarChar(10)
  status         String            @default("active") @db.VarChar(20) // active | inactive
  mfaSecret      String?           @map("mfa_secret") @db.VarChar(100)
  available      Boolean           @default(true)
  workingHours   Json?             @map("working_hours")
  dutyNurse      Boolean           @default(false) @map("duty_nurse")
  dutyDoctor     Boolean           @default(false) @map("duty_doctor")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  archivedAt     DateTime?         @map("archived_at")

  role           Role              @relation(fields: [roleId], references: [id])
  userBranches   UserBranch[]
  userTeams      UserTeam[]
  permissionGrants PermissionGrant[] @relation("GrantedToUser")
  givenGrants    PermissionGrant[]   @relation("GrantedByUser")
  ownedLeads     Lead[]            @relation("LeadOwner")
  ownedCases     Case[]            @relation("CaseOwner")
  doctorCases    Case[]            @relation("DoctorTreating")
  tasks          Task[]            @relation("TaskOwner")
  completedTasks Task[]            @relation("TaskCompletedBy")
  interactions   Interaction[]
  raisedEscalations Escalation[]   @relation("EscalationRaisedBy")
  assignedEscalations Escalation[] @relation("EscalationDoctor")
  decidedEscalations Escalation[]  @relation("EscalationDecidedBy")
  notifications  Notification[]
  auditLogs      AuditLog[]
  imports        Import[]
  exports        Export[]          @relation("ExportUser")
  approvedExports Export[]         @relation("ExportApprover")
  testimonialsCreated Testimonial[] @relation("TestimonialCreator")
  testimonialsApproved Testimonial[] @relation("TestimonialApprover")
  testimonialSends LeadTestimonialSend[] @relation("TestimonialSender")
  testimonialVoids LeadTestimonialSend[] @relation("TestimonialVoider")
  createdSchedules VisitSchedule[] @relation("ScheduleCreator")
  doctorSchedules VisitSchedule[] @relation("ScheduleDoctor")
  requestedExtensions ScheduleExtensionRequest[] @relation("ExtensionRequester")
  decidedExtensions ScheduleExtensionRequest[] @relation("ExtensionDecider")
  markedVisits ScheduledVisit[] @relation("VisitMarker")
  treatmentCheckins TreatmentCheckin[] @relation("CheckinUser")
  handoversSent CaseHandover[] @relation("HandoverFromUser")
  handoversReceived CaseHandover[] @relation("HandoverToUser")

  @@index([roleId])
  @@index([status])
  @@index([available])
  @@map("users")
}

model UserBranch {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  branchId  Int      @map("branch_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model Team {
  id        Int        @id @default(autoincrement()) @db.UnsignedInt
  code      String     @unique @db.VarChar(50) // support | admission | aftercare
  name      String     @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  userTeams UserTeam[]

  @@map("teams")
}

model UserTeam {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  teamId    Int      @map("team_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("user_teams")
}

model Role {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  maskPhone   Boolean          @default(false) @map("mask_phone")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  roleId     Int      @map("role_id") @db.UnsignedInt
  permission String   @db.VarChar(100)
  scope      String   @default("own") @db.VarChar(20) // own | team | branch | all

  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model PermissionGrant {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  userId     Int       @map("user_id") @db.UnsignedInt
  permission String    @db.VarChar(100)
  scope      String    @db.VarChar(20)
  reason     String    @db.Text
  startsAt   DateTime  @default(now()) @map("starts_at")
  endsAt     DateTime  @map("ends_at")
  grantedBy  Int       @map("granted_by") @db.UnsignedInt
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation("GrantedToUser", fields: [userId], references: [id], onDelete: Cascade)
  granter    User      @relation("GrantedByUser", fields: [grantedBy], references: [id])

  @@index([userId, endsAt])
  @@map("permission_grants")
}

// Picklist Tables
model Source {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  code      String   @unique @db.VarChar(50)
  labelEn   String   @map("label_en") @db.VarChar(100)
  labelMl   String   @map("label_ml") @db.VarChar(100)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads     Lead[]

  @@map("sources")
}

model Department {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  code      String   @unique @db.VarChar(50)
  labelEn   String   @map("label_en") @db.VarChar(100)
  labelMl   String   @map("label_ml") @db.VarChar(100)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads     Lead[]
  cases     Case[]
  testimonials Testimonial[]

  @@map("departments")
}

model CallOutcome {
  id           Int           @id @default(autoincrement()) @db.UnsignedInt
  code         String        @unique @db.VarChar(50)
  labelEn      String        @map("label_en") @db.VarChar(100)
  labelMl      String        @map("label_ml") @db.VarChar(100)
  active       Boolean       @default(true)
  sort         Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  interactions Interaction[]

  @@map("call_outcomes")
}

model LostReason {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  code      String   @unique @db.VarChar(50)
  labelEn   String   @map("label_en") @db.VarChar(100)
  labelMl   String   @map("label_ml") @db.VarChar(100)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads     Lead[]

  @@map("lost_reasons")
}

model DeclineReason {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  code      String   @unique @db.VarChar(50)
  labelEn   String   @map("label_en") @db.VarChar(100)
  labelMl   String   @map("label_ml") @db.VarChar(100)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cases     Case[]

  @@map("decline_reasons")
}

model ClosureCode {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  code      String   @unique @db.VarChar(50)
  labelEn   String   @map("label_en") @db.VarChar(100)
  labelMl   String   @map("label_ml") @db.VarChar(100)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cases     Case[]

  @@map("closure_codes")
}

// Core CRM Entities
model Lead {
  id                  Int          @id @default(autoincrement()) @db.UnsignedInt
  name                String       @db.VarChar(100)
  mobile              String       @db.VarChar(25)
  mobileNorm          String       @map("mobile_norm") @db.VarChar(20)
  altMobile           String?      @map("alt_mobile") @db.VarChar(25)
  altMobileNorm       String?      @map("alt_mobile_norm") @db.VarChar(20)
  language            String       @default("en") @db.VarChar(10)
  concern             String?      @db.Text
  departmentId        Int          @map("department_id") @db.UnsignedInt
  sourceId            Int          @map("source_id") @db.UnsignedInt
  campaignText        String?      @map("campaign_text") @db.VarChar(100)
  referrerText        String?      @map("referrer_text") @db.VarChar(100)
  status              String       @default("new") @db.VarChar(30)
  priority            String       @default("warm") @db.VarChar(10)
  ownerId             Int?         @map("owner_id") @db.UnsignedInt
  branchId            Int          @map("branch_id") @db.UnsignedInt
  consentCalls        Boolean      @default(true) @map("consent_calls")
  consentWhatsapp     Boolean      @default(false) @map("consent_whatsapp")
  consentSms          Boolean      @default(false) @map("consent_sms")
  consentDate         DateTime?    @map("consent_date")
  consentSource       String?      @map("consent_source") @db.VarChar(100)
  doNotContact        Boolean      @default(false) @map("do_not_contact")
  emergencyFlag       Boolean      @default(false) @map("emergency_flag")
  firstResponseDueAt  DateTime?    @map("first_response_due_at")
  firstResponseAt     DateTime?    @map("first_response_at")
  slaBreached         Boolean      @default(false) @map("sla_breached")
  closedReasonId      Int?         @map("closed_reason_id") @db.UnsignedInt
  closedAt            DateTime?    @map("closed_at")
  convertedPatientId  Int?         @map("converted_patient_id") @db.UnsignedInt
  testimonialsSentCount Int        @default(0) @map("testimonials_sent_count")
  testimonialsLastSentAt DateTime? @map("testimonials_last_sent_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  archivedAt          DateTime?    @map("archived_at")

  department          Department   @relation(fields: [departmentId], references: [id])
  source              Source       @relation(fields: [sourceId], references: [id])
  owner               User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  branch              Branch       @relation(fields: [branchId], references: [id])
  closedReason        LostReason?  @relation(fields: [closedReasonId], references: [id])
  convertedPatient    Patient?     @relation("ConvertedLead", fields: [convertedPatientId], references: [id])

  cases               Case[]
  appointments        Appointment[]
  tasks               Task[]
  interactions        Interaction[]
  testimonialSends    LeadTestimonialSend[]

  @@index([mobileNorm])
  @@index([altMobileNorm])
  @@index([status])
  @@index([priority])
  @@index([branchId])
  @@index([ownerId])
  @@index([firstResponseDueAt])
  @@index([archivedAt])
  @@index([testimonialsSentCount])
  @@map("leads")
}

model Patient {
  id          Int          @id @default(autoincrement()) @db.UnsignedInt
  patientCode String       @unique @map("patient_code") @db.VarChar(50)
  name        String       @db.VarChar(100)
  mobileNorm  String       @map("mobile_norm") @db.VarChar(20)
  language    String       @default("en") @db.VarChar(10)
  branchId    Int          @map("branch_id") @db.UnsignedInt
  dateOfBirth DateTime?    @map("date_of_birth") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  archivedAt  DateTime?    @map("archived_at")

  branch      Branch       @relation(fields: [branchId], references: [id])
  leads       Lead[]       @relation("ConvertedLead")
  cases       Case[]

  @@index([mobileNorm])
  @@index([branchId])
  @@map("patients")
}

model Case {
  id                     Int            @id @default(autoincrement()) @db.UnsignedInt
  patientId              Int            @map("patient_id") @db.UnsignedInt
  leadId                 Int?           @map("lead_id") @db.UnsignedInt
  branchId               Int            @map("branch_id") @db.UnsignedInt
  stage                  String         @default("visited") @db.VarChar(30)
  careType               String         @default("consultation_only") @map("care_type") @db.VarChar(30)
  departmentId           Int            @map("department_id") @db.UnsignedInt
  treatingDoctorId       Int?           @map("treating_doctor_id") @db.UnsignedInt
  consultationCompletedAt DateTime?     @map("consultation_completed_at")
  advisedAdmission       Boolean        @default(false) @map("advised_admission")
  estimatedAmount        Decimal?       @map("estimated_amount") @db.Decimal(12, 2)
  estimateSharedAt       DateTime?      @map("estimate_shared_at")
  depositReceived        Boolean        @default(false) @map("deposit_received")
  depositAmount          Decimal?       @map("deposit_amount") @db.Decimal(12, 2)
  expectedAdmissionDate  DateTime?      @map("expected_admission_date")
  admissionDate          DateTime?      @map("admission_date")
  dischargeDate          DateTime?      @map("discharge_date")
  treatmentCompletedAt   DateTime?      @map("treatment_completed_at")
  emergencyAdmission     Boolean        @default(false) @map("emergency_admission")
  emergencyReason        String?        @map("emergency_reason") @db.Text
  notStartedReasonId     Int?           @map("not_started_reason_id") @db.UnsignedInt
  closureCodeId          Int?           @map("closure_code_id") @db.UnsignedInt
  ownerId                Int?           @map("owner_id") @db.UnsignedInt
  team                   String         @default("admission") @db.VarChar(30)
  attendanceRate         Decimal?       @map("attendance_rate") @db.Decimal(5, 2)
  consecutiveMissed      Int            @default(0) @map("consecutive_missed")
  lastAttendedAt         DateTime?      @map("last_attended_at")
  nextVisitAt            DateTime?      @map("next_visit_at")
  adherenceRisk          String         @default("low") @map("adherence_risk") @db.VarChar(20) // low | medium | high
  expectedDischargeDate  DateTime?      @map("expected_discharge_date")
  setting                String?        @db.VarChar(20) // opd | inpatient
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  archivedAt             DateTime?      @map("archived_at")

  patient                Patient        @relation(fields: [patientId], references: [id])
  lead                   Lead?          @relation(fields: [leadId], references: [id])
  branch                 Branch         @relation(fields: [branchId], references: [id])
  department             Department     @relation(fields: [departmentId], references: [id])
  treatingDoctor         User?          @relation("DoctorTreating", fields: [treatingDoctorId], references: [id])
  owner                  User?          @relation("CaseOwner", fields: [ownerId], references: [id])
  notStartedReason       DeclineReason? @relation(fields: [notStartedReasonId], references: [id])
  closureCode            ClosureCode?   @relation(fields: [closureCodeId], references: [id])

  appointments           Appointment[]
  tasks                  Task[]
  interactions           Interaction[]
  escalations            Escalation[]
  schedules              VisitSchedule[]
  scheduledVisits        ScheduledVisit[]
  treatmentCheckins      TreatmentCheckin[]
  handovers              CaseHandover[]

  @@index([patientId])
  @@index([leadId])
  @@index([stage])
  @@index([branchId])
  @@index([ownerId])
  @@index([team])
  @@index([setting])
  @@index([adherenceRisk])
  @@map("cases")
}

model Appointment {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  leadId     Int?      @map("lead_id") @db.UnsignedInt
  caseId     Int?      @map("case_id") @db.UnsignedInt
  branchId   Int       @map("branch_id") @db.UnsignedInt
  doctorName String    @map("doctor_name") @db.VarChar(100)
  startsAt   DateTime  @map("starts_at")
  status     String    @default("booked") @db.VarChar(20) // booked | visited | missed | cancelled
  createdBy  Int?      @map("created_by") @db.UnsignedInt
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  lead       Lead?     @relation(fields: [leadId], references: [id])
  case       Case?     @relation(fields: [caseId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])

  @@index([leadId])
  @@index([caseId])
  @@index([startsAt])
  @@index([status])
  @@map("appointments")
}

model Task {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  type         String    @db.VarChar(30) // call | whatsapp | reminder | review | escalation_callback
  title        String    @db.VarChar(200)
  dueAt        DateTime  @map("due_at")
  priority     String    @default("warm") @db.VarChar(10) // hot | warm | cold
  ownerId      Int       @map("owner_id") @db.UnsignedInt
  leadId       Int?      @map("lead_id") @db.UnsignedInt
  caseId       Int?      @map("case_id") @db.UnsignedInt
  cadenceKey   String?   @map("cadence_key") @db.VarChar(100)
  cadenceStep  Int?      @map("cadence_step")
  status       String    @default("open") @db.VarChar(20) // open | done | cancelled | snoozed
  snoozeCount  Int       @default(0) @map("snooze_count")
  completedAt  DateTime? @map("completed_at")
  completedBy  Int?      @map("completed_by") @db.UnsignedInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  archivedAt   DateTime? @map("archived_at")

  owner        User      @relation("TaskOwner", fields: [ownerId], references: [id])
  completedUser User?    @relation("TaskCompletedBy", fields: [completedBy], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id])
  case         Case?     @relation(fields: [caseId], references: [id])

  @@index([ownerId])
  @@index([leadId])
  @@index([caseId])
  @@index([status])
  @@index([dueAt])
  @@index([cadenceKey])
  @@map("tasks")
}

model Interaction {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  type            String       @db.VarChar(30) // call | whatsapp_manual | note | status_change | visit | aftercare_call
  direction       String       @default("outbound") @db.VarChar(10) // inbound | outbound
  userId          Int          @map("user_id") @db.UnsignedInt
  leadId          Int?         @map("lead_id") @db.UnsignedInt
  caseId          Int?         @map("case_id") @db.UnsignedInt
  outcomeId       Int?         @map("outcome_id") @db.UnsignedInt
  durationSeconds Int?         @map("duration_seconds")
  note            String?      @db.Text
  details         Json?
  overrideReason  String?      @map("override_reason") @db.VarChar(500)
  occurredAt      DateTime     @default(now()) @map("occurred_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  archivedAt      DateTime?    @map("archived_at")

  user            User         @relation(fields: [userId], references: [id])
  lead            Lead?        @relation(fields: [leadId], references: [id])
  case            Case?        @relation(fields: [caseId], references: [id])
  outcome         CallOutcome? @relation(fields: [outcomeId], references: [id])

  @@index([leadId])
  @@index([caseId])
  @@index([userId])
  @@index([occurredAt])
  @@map("interactions")
}

model Escalation {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  caseId           Int       @map("case_id") @db.UnsignedInt
  raisedBy         Int       @map("raised_by") @db.UnsignedInt
  reason           String    @db.Text
  assignedDoctorId Int?      @map("assigned_doctor_id") @db.UnsignedInt
  decision         String?   @db.Text
  decidedBy        Int?      @map("decided_by") @db.UnsignedInt
  decidedAt        DateTime? @map("decided_at")
  dueAt            DateTime  @map("due_at")
  status           String    @default("pending") @db.VarChar(20) // pending | decided | cancelled
  escalationType   String    @default("clinical_red_flag") @map("escalation_type") @db.VarChar(50)
  wardNotified     Boolean   @default(false) @map("ward_notified")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  case             Case      @relation(fields: [caseId], references: [id])
  raisedUser       User      @relation("EscalationRaisedBy", fields: [raisedBy], references: [id])
  assignedDoctor   User?     @relation("EscalationDoctor", fields: [assignedDoctorId], references: [id])
  decidedUser      User?     @relation("EscalationDecidedBy", fields: [decidedBy], references: [id])
  treatmentCheckin TreatmentCheckin?

  @@index([caseId])
  @@index([assignedDoctorId])
  @@index([status])
  @@index([dueAt])
  @@index([escalationType])
  @@map("escalations")
}

model Cadence {
  id        Int           @id @default(autoincrement()) @db.UnsignedInt
  key       String        @unique @db.VarChar(100)
  name      String        @db.VarChar(150)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  steps     CadenceStep[]

  @@map("cadences")
}

model CadenceStep {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  cadenceId     Int      @map("cadence_id") @db.UnsignedInt
  stepNo        Int      @map("step_no")
  offsetUnit    String   @map("offset_unit") @db.VarChar(20) // minutes | hours | days
  offsetValue   Int      @map("offset_value")
  taskType      String   @default("call") @map("task_type") @db.VarChar(30)
  titleTemplate String   @map("title_template") @db.VarChar(200)
  assigneeRule  String   @default("owner") @map("assignee_rule") @db.VarChar(50) // owner | team_round_robin
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cadence       Cadence  @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  @@unique([cadenceId, stepNo])
  @@map("cadence_steps")
}

model AssignmentRule {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  name            String   @db.VarChar(100)
  resource        String   @db.VarChar(50) // lead | case_admission | case_aftercare
  priorityOrder   Int      @default(0) @map("priority_order")
  conditions      Json     // branch, language, department, source
  targetTeam      String   @map("target_team") @db.VarChar(50)
  maxOpenPerUser  Int      @default(50) @map("max_open_per_user")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([resource, active])
  @@map("assignment_rules")
}

model Notification {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  userId    Int       @map("user_id") @db.UnsignedInt
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  body      String    @db.Text
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  userId     Int?     @map("user_id") @db.UnsignedInt
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(50)
  entityId   Int?     @map("entity_id") @db.UnsignedInt
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(50)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Import {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  filename  String   @db.VarChar(255)
  status    String   @default("pending") @db.VarChar(30)
  counts    Json?
  errors    Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("imports")
}

model Setting {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  key       String   @unique @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model OutboxEvent {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  eventType   String    @map("event_type") @db.VarChar(100)
  payload     Json
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt])
  @@map("outbox_events")
}

model Export {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  userId           Int       @map("user_id") @db.UnsignedInt
  branchId         Int?      @map("branch_id") @db.UnsignedInt
  resource         String    @db.VarChar(50) // "leads" | "cases" | "interactions" | "audit_logs"
  filterJson       Json?     @map("filter_json")
  format           String    @default("csv") @db.VarChar(10)
  status           String    @default("pending") @db.VarChar(30) // "pending" | "approved" | "rejected" | "completed"
  requestedAt      DateTime  @default(now()) @map("requested_at")
  approvedBy       Int?      @map("approved_by") @db.UnsignedInt
  approvedAt       DateTime? @map("approved_at")
  downloadCount    Int       @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at")
  rejectionReason  String?   @map("rejection_reason") @db.VarChar(255)
  fileKey          String?   @map("file_key") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User      @relation("ExportUser", fields: [userId], references: [id])
  branch           Branch?   @relation(fields: [branchId], references: [id])
  approver         User?     @relation("ExportApprover", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([branchId])
  @@map("exports")
}

model Testimonial {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  title            String    @db.VarChar(200)
  type             String    @db.VarChar(20) // video | text | image | pdf
  url              String    @db.VarChar(500)
  language         String    @default("en") @db.VarChar(10) // en | ml | other
  departmentId     Int?      @map("department_id") @db.UnsignedInt
  summary          String    @db.Text
  consentConfirmed Boolean   @default(true) @map("consent_confirmed")
  consentReference String    @map("consent_reference") @db.VarChar(200)
  approvedBy       Int?      @map("approved_by") @db.UnsignedInt
  approvedAt       DateTime? @map("approved_at")
  active           Boolean   @default(true)
  createdBy        Int       @map("created_by") @db.UnsignedInt
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  archivedAt       DateTime? @map("archived_at")

  department       Department? @relation(fields: [departmentId], references: [id])
  creator          User        @relation("TestimonialCreator", fields: [createdBy], references: [id])
  approver         User?       @relation("TestimonialApprover", fields: [approvedBy], references: [id])
  sendItems        LeadTestimonialSendItem[]

  @@index([active])
  @@index([language])
  @@index([departmentId])
  @@map("testimonials")
}

model LeadTestimonialSend {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  leadId         Int       @map("lead_id") @db.UnsignedInt
  sentBy         Int       @map("sent_by") @db.UnsignedInt
  sentAt         DateTime  @default(now()) @map("sent_at")
  channel        String    @db.VarChar(30) // whatsapp | sms | email | call_readout | other
  note           String?   @db.Text
  overrideReason String?   @map("override_reason") @db.Text
  voidedAt       DateTime? @map("voided_at")
  voidedBy       Int?      @map("voided_by") @db.UnsignedInt
  voidReason     String?   @map("void_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender         User      @relation("TestimonialSender", fields: [sentBy], references: [id])
  voider         User?     @relation("TestimonialVoider", fields: [voidedBy], references: [id])
  items          LeadTestimonialSendItem[]

  @@index([leadId, sentAt])
  @@index([sentBy])
  @@map("lead_testimonial_sends")
}

model LeadTestimonialSendItem {
  id            Int                 @id @default(autoincrement()) @db.UnsignedInt
  sendId        Int                 @map("send_id") @db.UnsignedInt
  testimonialId Int                 @map("testimonial_id") @db.UnsignedInt

  send          LeadTestimonialSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  testimonial   Testimonial         @relation(fields: [testimonialId], references: [id])

  @@index([sendId])
  @@index([testimonialId])
  @@map("lead_testimonial_send_items")
}

// ==========================================
// Treatment Follow-up Desk Models
// ==========================================

model Therapy {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  code      String   @unique @db.VarChar(50)
  labelEn   String   @map("label_en") @db.VarChar(100)
  labelMl   String   @map("label_ml") @db.VarChar(100)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schedules VisitSchedule[]

  @@map("therapies")
}

model MissedReason {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  code      String   @unique @db.VarChar(50)
  labelEn   String   @map("label_en") @db.VarChar(100)
  labelMl   String   @map("label_ml") @db.VarChar(100)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visits    ScheduledVisit[]

  @@map("missed_reasons")
}

model VisitSchedule {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  caseId          Int       @map("case_id") @db.UnsignedInt
  setting         String    @default("opd") @db.VarChar(20) // opd | inpatient
  therapyId       Int       @map("therapy_id") @db.UnsignedInt
  frequencyType   String    @map("frequency_type") @db.VarChar(30)
  intervalN       Int?      @map("interval_n")
  weekdays        Json?
  customDates     Json?     @map("custom_dates")
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  totalSessions   Int?      @map("total_sessions")
  windowStart     String    @default("09:00") @map("window_start") @db.VarChar(10)
  windowEnd       String    @default("11:00") @map("window_end") @db.VarChar(10)
  durationMinutes Int       @default(60) @map("duration_minutes")
  doctorId        Int?      @map("doctor_id") @db.UnsignedInt
  notes           String?   @db.Text
  status          String    @default("active") @db.VarChar(20) // active | paused | completed | cancelled
  pausedUntil     DateTime? @map("paused_until")
  pauseReason     String?   @map("pause_reason") @db.Text
  createdBy       Int       @map("created_by") @db.UnsignedInt
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  therapy         Therapy   @relation(fields: [therapyId], references: [id])
  doctor          User?     @relation("ScheduleDoctor", fields: [doctorId], references: [id])
  creator         User      @relation("ScheduleCreator", fields: [createdBy], references: [id])
  visits          ScheduledVisit[]
  extensionRequests ScheduleExtensionRequest[]

  @@index([caseId])
  @@index([status])
  @@index([therapyId])
  @@index([doctorId])
  @@map("visit_schedules")
}

model ScheduleExtensionRequest {
  id                 Int       @id @default(autoincrement()) @db.UnsignedInt
  scheduleId         Int       @map("schedule_id") @db.UnsignedInt
  requestedBy        Int       @map("requested_by") @db.UnsignedInt
  additionalSessions Int?      @map("additional_sessions")
  newEndDate         DateTime? @map("new_end_date")
  reason             String    @db.Text
  status             String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  decidedBy          Int?      @map("decided_by") @db.UnsignedInt
  decidedAt          DateTime? @map("decided_at")
  rejectionReason    String?   @map("rejection_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  schedule           VisitSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  requester          User          @relation("ExtensionRequester", fields: [requestedBy], references: [id])
  decider            User?         @relation("ExtensionDecider", fields: [decidedBy], references: [id])

  @@index([scheduleId])
  @@index([status])
  @@map("schedule_extension_requests")
}

model ScheduledVisit {
  id            Int          @id @default(autoincrement()) @db.UnsignedInt
  scheduleId    Int          @map("schedule_id") @db.UnsignedInt
  caseId        Int          @map("case_id") @db.UnsignedInt
  sessionNo     Int          @map("session_no")
  scheduledDate DateTime     @map("scheduled_date")
  windowStart   String       @default("09:00") @map("window_start") @db.VarChar(10)
  windowEnd     String       @default("11:00") @map("window_end") @db.VarChar(10)
  status        String       @default("planned") @db.VarChar(20) // planned | reminded | attended | missed | rescheduled | cancelled | excused
  movedFromDate DateTime?    @map("moved_from_date")
  movedReason   String?      @map("moved_reason") @db.VarChar(255)
  markedBy      Int?         @map("marked_by") @db.UnsignedInt
  markedAt      DateTime?    @map("marked_at")
  missedReasonId Int?        @map("missed_reason_id") @db.UnsignedInt
  rescheduledTo DateTime?    @map("rescheduled_to")
  note          String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  schedule      VisitSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  marker        User?         @relation("VisitMarker", fields: [markedBy], references: [id])
  missedReason  MissedReason? @relation(fields: [missedReasonId], references: [id])

  @@index([scheduleId])
  @@index([caseId])
  @@index([scheduledDate])
  @@index([status])
  @@map("scheduled_visits")
}

model TreatmentCheckin {
  id                 Int         @id @default(autoincrement()) @db.UnsignedInt
  caseId             Int         @map("case_id") @db.UnsignedInt
  userId             Int         @map("user_id") @db.UnsignedInt
  channel            String      @default("call") @db.VarChar(20) // call | bedside
  contactedWho       String      @map("contacted_who") @db.VarChar(100)
  condition          String      @db.VarChar(30) // comfortable | uncomfortable | unwell
  therapiesAsPlanned String      @default("yes") @map("therapies_as_planned") @db.VarChar(20) // yes | partly | no
  missedTherapiesNote String?    @map("missed_therapies_note") @db.Text
  concerns           String?     @db.Text
  billingConcern     Boolean     @default(false) @map("billing_concern")
  expectedDischargeDate DateTime? @map("expected_discharge_date")
  nextCheckinAt      DateTime?   @map("next_checkin_at")
  escalationId       Int?        @unique @map("escalation_id") @db.UnsignedInt
  occurredAt         DateTime    @default(now()) @map("occurred_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  case               Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user               User        @relation("CheckinUser", fields: [userId], references: [id])
  escalation         Escalation? @relation(fields: [escalationId], references: [id])

  @@index([caseId])
  @@index([userId])
  @@index([occurredAt])
  @@map("treatment_checkins")
}

model CaseHandover {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  caseId     Int      @map("case_id") @db.UnsignedInt
  fromTeam   String   @map("from_team") @db.VarChar(50)
  toTeam     String   @map("to_team") @db.VarChar(50)
  fromUserId Int?     @map("from_user_id") @db.UnsignedInt
  toUserId   Int?     @map("to_user_id") @db.UnsignedInt
  note       String   @db.Text
  at         DateTime @default(now())

  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromUser   User?    @relation("HandoverFromUser", fields: [fromUserId], references: [id])
  toUser     User?    @relation("HandoverToUser", fields: [toUserId], references: [id])

  @@index([caseId])
  @@index([at])
  @@map("case_handovers")
}
