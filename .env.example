# Database Configuration
DATABASE_URL="mysql://root:@localhost:3306/hospital_crm?charset=utf8mb4"
DB_ROOT_PASSWORD="rootpassword"
DB_NAME="hospital_crm"
DB_USER="crm_user"
DB_PASSWORD="crm_password"
DB_PORT=3306

# API Configuration
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL="info"

# Security & Secrets
JWT_ACCESS_SECRET="dev-jwt-access-secret-minimum-32-characters-long"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-minimum-32-characters-long"
COOKIE_SECRET="dev-cookie-secret-minimum-32-characters-long"
SESSION_IDLE_TIMEOUT_MINUTES=30
MFA_ENABLED_DEFAULT=false

# Web Frontend Configuration
NUXT_PUBLIC_API_BASE="http://localhost:4000/api/v1"
