{
  "name": "hospital-crm-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital CRM - Telecalling Module (Phase 1)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @hospital-crm/api dev",
    "dev:web": "pnpm --filter @hospital-crm/web dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "test:unit": "pnpm --filter @hospital-crm/api test:unit",
    "test:api": "pnpm --filter @hospital-crm/api test:api",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "seed": "pnpm --filter @hospital-crm/api seed",
    "db:migrate": "pnpm --filter @hospital-crm/api db:migrate",
    "db:generate": "pnpm --filter @hospital-crm/api db:generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^1.4.0"
  },
  "packageManager": "pnpm@11.17.0"
}
