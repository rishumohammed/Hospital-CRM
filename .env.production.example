# ==============================================================
# Hospital CRM - Production Environment Configuration
# Copy this file to .env on your Ubuntu server before launching:
#   cp .env.production.example .env
# ==============================================================

# Database Credentials
DB_ROOT_PASSWORD=change_this_root_password_12345
DB_NAME=hospital_crm
DB_USER=crm_user
DB_PASSWORD=change_this_user_password_12345
DB_PORT=3306

# Node / Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT and Session Security (Generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=change_me_to_a_32_character_random_access_secret
JWT_REFRESH_SECRET=change_me_to_a_32_character_random_refresh_secret
COOKIE_SECRET=change_me_to_a_32_character_random_cookie_secret

# Session Timeout and 2FA
SESSION_IDLE_TIMEOUT_MINUTES=30
MFA_ENABLED_DEFAULT=false

# Web Frontend (Relative path for seamless Nginx reverse proxy)
NUXT_PUBLIC_API_BASE=/api/v1
CORS_ORIGIN=*

