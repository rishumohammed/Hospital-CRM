# ==============================================================
# Hospital CRM - Production Environment Configuration
# Target Domain: portal.samadselements.com
# ==============================================================

# Database Configuration & Dedicated Storage
DB_ROOT_PASSWORD=5@mads3LewenT%%
DB_PASSWORD=5@mads3LewenT%%
DB_NAME=hospital_crm
DB_USER=crm_user
DB_PORT=3306

# Host path where MySQL data will be stored separately:
DB_DATA_PATH=/var/lib/hospital-crm-data/mysql

# Node Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT and Session Security (Auto-generated by deploy.sh)
JWT_ACCESS_SECRET=change_me_to_a_32_character_random_access_secret
JWT_REFRESH_SECRET=change_me_to_a_32_character_random_refresh_secret
COOKIE_SECRET=change_me_to_a_32_character_random_cookie_secret

# Session Timeout and 2FA
SESSION_IDLE_TIMEOUT_MINUTES=30
MFA_ENABLED_DEFAULT=false

# Domain & Web Settings
DOMAIN_NAME=portal.samadselements.com
NUXT_PUBLIC_API_BASE=/api/v1
CORS_ORIGIN=https://portal.samadselements.com,http://portal.samadselements.com
